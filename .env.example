# ---- Database ----
# Local dev (docker-compose postgres service):
DATABASE_URL=postgresql://devcenter:devcenter@localhost:5432/devcenter
# Producción (Neon): usar el connection string "pooled" (pgbouncer) para DATABASE_URL
# y el connection string directo para DIRECT_URL (usado solo por las migraciones de Prisma).
DIRECT_URL=postgresql://devcenter:devcenter@localhost:5432/devcenter

# ---- Google OAuth 2.0 ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ---- Auth / cookies ----
# Secreto para firmar el JWT propio emitido tras el login con Google. Generar con: openssl rand -base64 48
SESSION_SECRET=

# ---- URLs ----
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# ---- Server ----
NODE_ENV=development
PORT=3001
